# Supabase (publishable credentials only — no service/secret key in the app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: emit JSON server-operation timing logs in production
# PERFORMANCE_LOGGING_ENABLED=true

# Local ETL loader only (not used by the deployed Next.js application)
SUPABASE_SECRET_KEY=
